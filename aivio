<script>
  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold:0.12});
  revealEls.forEach(el => io.observe(el));

  // Portal slider drag
  const frame = document.getElementById('portal');
  const handle = document.getElementById('portalHandle');
  const remix = document.getElementById('remixSide');
  let dragging = false;

  function setSplit(pct){
    pct = Math.max(4, Math.min(96, pct));
    remix.style.clipPath = `inset(0 0 0 ${pct}%)`;
    handle.style.left = pct + '%';
    handle.setAttribute('aria-valuenow', Math.round(pct));
  }
  function setSplitFromClientX(clientX){
    const rect = frame.getBoundingClientRect();
    setSplit(((clientX - rect.left) / rect.width) * 100);
  }

  handle.addEventListener('pointerdown', (e) => { dragging = true; userInteracted = true; handle.setPointerCapture(e.pointerId); });
  window.addEventListener('pointermove', (e) => { if(dragging) setSplitFromClientX(e.clientX); });
  window.addEventListener('pointerup', () => dragging = false);
  frame.addEventListener('click', (e) => { if(!dragging) setSplitFromClientX(e.clientX); });

  handle.addEventListener('keydown', (e) => {
    const current = parseFloat(handle.style.left) || 50;
    if(e.key === 'ArrowLeft'){ userInteracted = true; setSplit(current - 5); e.preventDefault(); }
    if(e.key === 'ArrowRight'){ userInteracted = true; setSplit(current + 5); e.preventDefault(); }
  });

  // Gentle ambient auto-demo before first interaction
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let userInteracted = false;
  ['pointerdown','touchstart'].forEach(evt => frame.addEventListener(evt, () => userInteracted = true));

  if(!reduced){
    let t = 0;
    const rect = () => frame.getBoundingClientRect();
    function ambient(){
      if(!userInteracted){
        t += 0.012;
        const pct = 50 + Math.sin(t) * 32;
        remix.style.clipPath = `inset(0 0 0 ${pct}%)`;
        handle.style.left = pct + '%';
      }
      requestAnimationFrame(ambient);
    }
    requestAnimationFrame(ambient);
  }
</script>

